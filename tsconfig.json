{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "declaration": false,
    "outDir": "dist",
    "noEmit": true,
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "jsx": "react-jsx",
    "allowImportingTsExtensions": true,
    "types": [
      "node"
    ],
    "moduleResolution": "Bundler",
    "baseUrl": ".",
    "paths": {
      "@src/*": [
        "src/*"
      ]
    }
  },
  "include": [
    "packages/**/*",
    "services/**/*",
    "agents/**/*",
    "scripts/**/*.ts",
    "aws/**/*",
    "src/**/*",
    "types/**/*.d.ts",
    "cypress.d.ts"
  ]
}
