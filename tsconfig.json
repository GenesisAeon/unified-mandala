{
  "compilerOptions": {
    "target": "ES2020",
    "module": "CommonJS",
    "declaration": false,
    "outDir": "dist",
    "noEmit": true,
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "jsx": "react-jsx",
    "allowImportingTsExtensions": true,
    "types": ["node"]
  },
  "include": [
    "packages/**/*",
    "services/**/*",
    "agents/**/*",
    "scripts/**/*.ts",
    "aws/**/*",
    "src/**/*",
    "types/**/*.d.ts",
    "cypress.d.ts"
  ]
}
