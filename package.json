{
  "name": "unified-mandala",
  "private": true,
  "version": "1.0.0",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "build": "tsc -b",
    "lint": "tsc -p tsconfig.json --noEmit",
    "test": "jest",
    "test:agents": "vitest run",
    "dev": "ts-node scripts/dev-server.ts",
    "docs:build": "typedoc",
    "docs:auto": "node scripts/generate-api-docs.js",
    "prepare": "husky install",
    "split:conversations": "node scripts/split-conversations.js",
    "grep:conversations": "node scripts/filter-conversations.js",
    "analyze:conversations": "node scripts/analyze-conversations.js",
    "update:advanced-todo": "node scripts/update-advanced-todo.js",
    "export:crep-docs": "node scripts/export-crep-docs.js",
    "symbolzeit:run": "node scripts/symbolzeit-runner.js",
    "generate:next-sigil": "node scripts/generate-next-sigil.js",
    "aeon:transition": "node scripts/aeon-transition-workflow.js"
  },
  "dependencies": {
    "ajv": "^8.0.0",
    "ajv-formats": "^3.0.1",
    "commander": "^11.0.0",
    "d3": "^7.8.5",
    "three": "^0.161.0",
    "focus-trap-react": "^9.0.2",
    "glob": "^8.0.0",
    "js-yaml": "^4.1.0",
    "mitt": "^3.0.0",
    "nats": "^2.29.3",
    "node-fetch": "2",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-tooltip": "^5.18.0",
    "recharts": "^2.8.0",
    "socket.io-client": "^4.7.5",
    "yaml": "^2.8.0"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.0",
    "@types/d3": "^7.4.3",
    "@types/glob": "^8.1.0",
    "@types/jest": "^29.5.7",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^20.10.0",
    "@types/react": "^18.2.21",
    "@types/react-dom": "^18.2.7",
    "@types/react-tooltip": "^4.2.4",
    "@types/three": "^0.164.0",
    "husky": "^9.0.0",
    "jest": "^29.6.4",
    "jest-environment-jsdom": "30.0.0-beta.3",
    "ts-jest": "^29.1.1",
    "ts-node": "^10.9.2",
    "typedoc": "^0.25.3",
    "typescript": "^5.4.0",
    "vitest": "^1.5.0"
  }
}
