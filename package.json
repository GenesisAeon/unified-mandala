    "start": "pnpm -s build:ui && pnpm -s dev",
    "start:light": "pnpm -s build:ui && node scripts/light-static-server.mjs",
    "start:all": "pnpm dev:stack",
    "sub:cosmic": "node scripts/realtime/sub-cosmic.mjs",
