{
  "$id": "https://unified-mandala.org/schemas/sigil-message.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SigilMessage",
  "type": "object",
  "required": ["symbol", "intent", "context", "meta"],
  "properties": {
    "symbol": { "type": "string", "minLength": 1, "maxLength": 8 },
    "intent": {
      "type": "string",
      "enum": ["inform", "warn", "alarm", "celebrate"]
    },
    "context": { "type": "string", "minLength": 1 },
    "meta": {
      "type": "object",
      "required": ["ts", "source"],
      "properties": {
        "ts": { "type": "string", "format": "date-time" },
        "source": { "type": "string", "minLength": 1 },
        "crep": {
          "type": "object",
          "properties": {
            "coherence": { "type": "number", "minimum": 0, "maximum": 1 },
            "resonance": { "type": "number", "minimum": 0, "maximum": 1 },
            "emergence": { "type": "number", "minimum": 0, "maximum": 1 },
            "poetics": { "type": "number", "minimum": 0, "maximum": 1 }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": false
}
