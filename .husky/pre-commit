pnpm store:commit-memory >/dev/null 2>&1 || true

# Increase Node.js memory for hook subprocesses (eslint, prettier, vitest)
export NODE_OPTIONS="${NODE_OPTIONS:---max-old-space-size=4096}"

export PANTHEON_DISABLE=1
export CI=1

# Use repo-local temp to avoid ENOSPC on system tmp
mkdir -p tmp >/dev/null 2>&1 || true
export TMPDIR="$(pwd)/tmp"
export TEMP="$TMPDIR"
export TMP="$TMPDIR"

if [ -n "$UM_SKIP_HEAVY_HOOKS" ]; then
  echo "[husky] UM_SKIP_HEAVY_HOOKS=1 → running lint-staged only"
  pnpm run lint-staged -- --concurrent false || exit $?
  exit 0
fi

pnpm run lint-staged -- --concurrent false || exit $?
pnpm guard:no-dotenv || exit $?
pnpm typecheck || exit $?
pnpm test:unit || exit $?
pnpm schema:validate || exit $?
pnpm maps:validate || exit $?
pnpm repomap:build || exit $?
pnpm repomap:validate || exit $?
pnpm sanity || exit $?
pnpm policy:check || exit $?
pnpm guard:no-local-paths || exit $?
pnpm meta:fraktal:organize || true
pnpm meta:check || true
pnpm meta:mandala:validate || true
if [ "${UM_STRICT_META:-0}" = "1" ]; then
  echo "[husky] UM_STRICT_META=1 → running strict MandalaMap validation"
  pnpm meta:mandala:validate:strict || exit $?
fi
