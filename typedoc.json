{
  "entryPoints": ["packages"],
  "out": "docs/api",
  "exclude": ["**/*.test.ts", "**/*.test.tsx", "**/*.stories.tsx"],
  "entryPointStrategy": "expand",
  "tsconfig": "tsconfig.json",
  "includeVersion": true,
  "excludeInternal": true,
  "readme": "none",
  "validation": {
    "invalidLink": false,
    "notExported": false
  }
}
