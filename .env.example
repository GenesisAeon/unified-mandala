API_URL=https://api.genesis-framework.de      # Basis-URL für REST/GraphQL
WEBSOCKET_URL=wss://api.genesis-framework.de  # WebSocket-Endpunkt für Sigillin-Sync

IDENTITY_PORT=3001                            # Port Identity-Service
REGISTRY_PORT=3002                            # Port Registry-Service
COLLAB_PORT=3003                              # Port Kollaborations-Service
ADMIN_PORT=3004                               # Port Admin-Service
SHARE_API_PORT=3001                           # Port Share API (Dev-Stack Override)
EXPERIMENTS_API_PORT=3002                     # Port Experiments API (Dev-Stack Override)
RAG_API_PORT=3003                             # Port RAG API (Dev-Stack Override)
FLAGS_API_PORT=3004                           # Port Feature-Flags API (Dev-Stack Override)
REALTIME_HUB_PORT=4020                        # Port Realtime Hub HTTP
REALTIME_WS_PORT=4021                         # Port Realtime Hub WS
UI_DEV_URL=http://localhost:5173              # UI Dev-Server URL für Smoke-Tests
ETHICS_DEP_FAIL_MODE=red                      # fail-closed Modus: 'red' (200 + rot) oder 'error' (503)
ETHICS_JSON_LIMIT=1mb                         # Maximalgröße JSON-Body Ethics-API
BOUNDARY_TIMEOUT_MS=1500                      # Timeout für Boundary-/ethics observe Aufrufe
BOUNDARY_RETRIES=2                            # Retry-Anzahl für Boundary observe
BOUNDARY_CB_FAILS=3                           # Fehlerzahl bis Circuit geöffnet wird
BOUNDARY_CB_COOLDOWN_MS=10000                 # Cooldown bevor Circuit halb-offen testet (ms)
INTERNAL_BEARER=                              # Optionales internes Service-Token für Fetch-Clients
VERIFY_GATE_TIMEOUT_MS=2000                   # Timeout für Ethics-Call im Verify-Gate
VERIFY_GATE_JSON_LIMIT=128kb                  # Maximalgröße JSON-Body Verify-Gate
VERIFY_GATE_UPSTREAM_TIMEOUT_MS=30000         # Timeout für Upstream-Proxy (ms)
VERIFY_UPSTREAM_URL=http://localhost:4000     # Zielservice für freigegebene Requests
VERIFY_ETHICS_URL=http://localhost:3110       # Ethics-Service Basis-URL
VERIFY_GATE_RPS=60                            # Requests pro Minute (express-rate-limit)
VERIFY_GATE_RATE_RPM=10                       # Zusätzliche Rate-Limits pro Subject (Requests/Minute)
VERIFY_GATE_UPSTREAM_ALLOWLIST=127.0.0.1:4000 # Erlaubte Host:Port-Ziele (SSRF-Schutz)
VERIFY_GATE_ALLOW_PROTOCOLS=http,https        # Erlaubte Protokolle (Komma-getrennt, z.B. http,https)
VERIFY_GATE_IDEMP_DB=./data/verify-gate-idem.sqlite # Speicherort Idempotency/JTI-Store
VERIFY_GATE_IDEMP_TTL_MS=60000                # TTL für Idempotency-Cache (ms)
VERIFY_GATE_GC_MS=60000                       # Basisintervall für Idempotency/JTI-GC
VERIFY_STRICT_SAME_HOST=0                     # '1' beschränkt Ziel-Hosts auf localhost
VERIFY_GATE_JWT_SECRET=change-me              # Secret zur Signatur von Ethics-Verdict-Tokens (Fallback)
VERIFY_GATE_JWT_SECRETS=                      # kid:secret(base64) Paare, Komma-getrennt
VERIFY_GATE_JWT_ACTIVE_KID=                   # aktives kid während Rotation
VERIFY_GATE_REQUIRE_POLICY_SIGNATURE=0        # 1 erzwingt gültige Policy-Signatur in /readyz
ETHICS_CACHE_TTL_MS=60000                     # Cache-Dauer Boundary-Ergebnisse (ms)
ETHICS_REQUIRE_UNIQUE_EVIDENCE_DOMAINS=2      # Mindestanzahl einzigartiger Evidence-Domains
LOG_SAMPLE_GREEN=0.01                         # Sampling-Rate für grüne Ethics-Logs
ETHICS_OPA_BUNDLE=                            # Optionaler Pfad zu OPA Bundle/Policy
ETHICS_OPA_PATH=                              # Alternativ: lokales Policy- oder Bundle-File
ETHICS_OPA_QUERY=data.mandala.ethics.output   # OPA Query für Verdict-Enforcement
ETHICS_OPA_TIMEOUT_MS=400                     # Timeout für OPA-Evaluierung (ms)
ETHICS_OPA_SIG_SHA256=                        # Erwartete SHA256-Summe des Bundles (optional, sonst .sha256-Datei)
ETHICS_OPA_SIG_SHA256_FILE=                   # Alternativer Pfad zur SHA256-Referenzdatei (Default: <bundle>.sha256)
ETHICS_OPA_SIG_ASC=                           # ASCII-armierte GPG-Signatur (optional, Default: <bundle>.asc)
ETHICS_OPA_PUBRING=                           # Pfad zu GPG-Public-Keyring für Verifikation (optional)
ETHICS_POLICY_SIGNATURE_REQUIRED=0            # 1 erzwingt gültige Signatur für /readyz
ETHICS_POLICY_REV=                            # Fallback Policy-Revision, wenn Manifest nicht gelesen werden kann
OPA_BIN=./bin/opa                             # Pfad zur lokalen OPA-Binary für Tests/CI
OPA_SIGN_ENABLE=0                             # Auf 1 setzen, um Bundles per GPG zu signieren
OPA_SIGN_GPG_KEY=                             # GPG-Key-ID oder Fingerprint für Bundle-Signaturen
OPA_SIGN_GPG_BIN=gpg                          # GPG-Binary zum Signieren (gpg/gpg2)

CREP_THRESHOLD_EMERGENCE=0.8                  # Schwelle E-Wert zur Emergenz-Erkennung
CREP_THRESHOLD_PERSISTENCE=0.3                # Schwelle P-Wert zur Persistenz-Filterung

JWT_SECRET=dein-geheimes-token                # Secret für JWT-Signatur
SESSION_SECRET=dein-session-secret            # Secret für Session-Management
 
# Agents Logging/Dirs
AGENTS_LOG_DIR=./data/agents/logs

LOG_LEVEL=info
REDIS_URL=redis://localhost:6379
# ERA5 / CDS
CDS_API_URL=https://cds.climate.copernicus.eu/api/v2
CDS_API_KEY=__set_me__
# Parser
SIGILS_STRICT=true
VITE_FEATURE_RESONANCE=on
VITE_FEATURE_EMERGENCE_EXPLORER=off
VITE_FEATURE_PROMPT_COACH=on
# optional remote optimizer (default offline)
# PROMPT_OPTIMIZER_URL=
# PROMPT_OPTIMIZER_KEY=
