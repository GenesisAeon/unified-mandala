+import fs from 'fs';
+import path from 'path';
+import { AeonTranspilerAgent } from './AeonTranspilerAgent';
+
+describe('AeonTranspilerAgent', () => {
+  const output = 'tmp-aeon.ts';
+
+  afterEach(() => {
+    if (fs.existsSync(output)) fs.unlinkSync(output);
+  });
+
+  it('transpiles aeon source to TS file', async () => {
+    const agent = new AeonTranspilerAgent(output);
+    const task = { id: '1', description: 'TASK Demo' } as any;
+    await agent.handle(task);
+    const content = fs.readFileSync(path.resolve(output), 'utf-8');
+    expect(content).toContain('Demo');
+    expect(content).toContain('aeonTasks');
+  });
+});
