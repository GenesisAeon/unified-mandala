              "{\"updates\":[{\"pattern\":\"$\",\"multiple\":false,\"replacement\":\"\\n\\n## 4. UI-Skeleton & Three-Fiber-Integration\\n\\nDieses Paket `ui` enthält das Grundgerüst für die visualisierte Pyramid-Suite in React und react-three-fiber.\\n\\n### 4.1 App-Entry & Context\\n```tsx\\n// packages/ui/src/App.tsx\\nimport React from 'react';\\nimport { Canvas } from '@react-three/fiber';\\nimport { ThreeDPyramid } from './components/ThreeDPyramid';\\nimport { SigilSelector } from './components/SigilSelector';\\nimport { MetricsDashboard } from './components/MetricsDashboard';\\nimport { AudioContextProvider } from './audio/PhiTone';\\nimport './index.css';\\n\\nexport function App() {\\n  return (\\n    <AudioContextProvider>\\n      <div className=\\\"app-container\\\">\\n        <SigilSelector />\\n        <Canvas camera={{ position: [0, 5, 10] }}>\\n          <ambientLight />\\n          <pointLight position={[10, 10, 10]} />\\n          <ThreeDPyramid />\\n        </Canvas>\\n        <MetricsDashboard />\\n      </div>\\n    </AudioContextProvider>\\n  );\\n}\\n```\\n\\n### 4.2 ThreeDPyramid Komponente\\n```tsx\\n// packages/ui/src/components/ThreeDPyramid.tsx\\nimport React, { useEffect, useState } from 'react';\\nimport { useFrame } from '@react-three/fiber';\\nimport { Layer } from 'common/layers/Layer';\\nimport { generateNestedLayers } from 'common/layers/generateNestedLayers';\\n\\nexport function ThreeDPyramid() {\\n  const [root] = useState<Layer>(() => generateNestedLayers(4, 5));\\n\\n  return <group>{renderLayer(root, 0)}</group>;\\n}\\n\\nfunction renderLayer(layer: Layer, idxOffset: number) {\\n  return (\\n    <group key={layer.id} position={[idxOffset * 1.5, -layer.level, 0]}> \\n      <mesh>\\n        <boxGeometry args={[layer.weight, layer.weight, layer.weight]} />\\n        <meshStandardMaterial color={`hsl(${layer.level * 30}, 60%, 50%)`} />\\n      </mesh>\\n      {layer.children?.map((c, i) => renderLayer(c, idxOffset + i - layer.children!.length / 2))}\\n    </group>\\n  );\\n}\\n```\\n\\n### 4.3 SigilSelector Komponente\\n```tsx\\n// packages/ui/src/components/SigilSelector.tsx\\nimport React, { useEffect, useState } from 'react';\\nimport type { TheoryConfig } from 'common/utils/validateConfig';\\n\\nexport function SigilSelector() {\\n  const [sigils, setSigils] = useState<string[]>([]);\\n\\n  useEffect(() => {\\n    fetch('/api/plugins')\\n      .then(r => r.json())\\n      .then((data: TheoryConfig[]) => setSigils(data.map(c => c.sigilAlert.success)));\\n  }, []);\\n\\n  return (\\n    <div className=\\\"sigil-selector\\\">\\n      <label htmlFor=\\\"sigil\\\">Sigil auswählen:</label>\\n      <select id=\\\"sigil\\\">\\n        {sigils.map(id => <option key={id} value={id}>{id}</option>)}\\n      </select>\\n    </div>\\n  );\\n}\\n```\\n\\n### 4.4 MetricsDashboard Komponente\\n```tsx\\n// packages/ui/src/components/MetricsDashboard.tsx\\nimport React, { useEffect, useState } from 'react';\\n\\nexport function MetricsDashboard() {\\n  const [metrics, setMetrics] = useState<{name:string; value:number}[]>([]);\\n\\n  useEffect(() => {\\n    fetch('/metrics')\\n      .then(r => r.json())\\n      .then(data => setMetrics(Object.entries(data).map(([name, v]) => ({ name, value: Number(v) }))));\\n  }, []);\\n\\n  return (\\n    <table className=\\\"metrics-dashboard\\\">\\n      <thead><tr><th>Metric</th><th>Value</th></tr></thead>\\n      <tbody>\\n        {metrics.map(m => (\\n          <tr key={m.name}><td>{m.name}</td><td>{m.value.toFixed(2)}</td></tr>\\n        ))}\\n      </tbody>\\n    </table>\\n  );\\n}\\n```\\n\\n### 4.5 AudioProvider & PhiTone Hook\\n```ts\\n// packages/ui/src/audio/PhiTone.tsx\\nimport React, { createContext, useContext, useMemo } from 'react';\\n\\nconst AudioContextCtx = createContext<AudioContext | null>(null);\\n\\nexport const AudioContextProvider: React.FC = ({ children }) => {\\n  const ctx = useMemo(() => new AudioContext(), []);\\n  return <AudioContextCtx.Provider value={ctx}>{children}</AudioContextCtx.Provider>;\\n};\\n\\nexport function usePhiTone(frequencyMultiplier: number) {\\n  const ctx = useContext(AudioContextCtx)!;\\n  return (value: number) => {\\n    const osc = ctx.createOscillator();\\n    osc.frequency.value = value * frequencyMultiplier;\\n    osc.connect(ctx.destination);\\n    osc.start();\\n    osc.stop(ctx.currentTime + 0.5);\\n  };\\n}\\n```\\n\"}]}"
