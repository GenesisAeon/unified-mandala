              "{\"updates\":[{\"pattern\":\"(?m)^## 10\\\\. Fehler- und Zustandsmanagement\",\"multiple\":false,\"replacement\":\"## 10. Fehler- und Zustandsmanagement\\n\\n### Erweiterte Implementierung: Fehler- und Zustandsmanagement\\n\\n#### 10.1 FallbackSynthesizer & ErrorRecoveryService (Core)\\n```typescript\\n// src/error/FallbackSynthesizer.ts\\nexport class FallbackSynthesizer {\\n  private audioContext: AudioContext;\\n\\n  constructor(sharedContext?: AudioContext) {\\n    this.audioContext = sharedContext || new AudioContext();\\n  }\\n\\n  /**\\n   * Spielt einen Ersatz-Ton, wenn KI-/Audio-Fehler auftreten.\\n   */\\n  playFallbackTone(duration = 0.5) {\\n    const osc = this.audioContext.createOscillator();\\n    osc.frequency.value = 220;\\n    osc.type = 'sine';\\n    osc.connect(this.audioContext.destination);\\n    osc.start();\\n    osc.stop(this.audioContext.currentTime + duration);\\n  }\\n}\\n```\\n\\n```typescript\\n// src/error/ErrorRecoveryService.ts\\nimport { EventEmitter } from 'events';\\nimport { FallbackSynthesizer } from './FallbackSynthesizer';\\n\\nexport class ErrorRecoveryService {\\n  constructor(\\n    private emitter: EventEmitter,\\n    private fallback = new FallbackSynthesizer()\\n  ) {\\n    this.setupListeners();\\n  }\\n\\n  private setupListeners() {\\n    this.emitter.on('error', (err: Error, module: string) => {\\n      console.error(`[Recovery] Fehler in ${module}:`, err);\\n      this.fallback.playFallbackTone();\\n      this.emitter.emit('ui:error', { module, message: err.message });\\n      setTimeout(() => this.emitter.emit('restart', module), 1000);\\n    });\\n  }\\n}\\n```\\n\\n#### 10.2 Integration ins System-Setup\\n```typescript\\n// src/index.ts\\nimport { EventEmitter } from 'events';\\nimport { ErrorRecoveryService } from './error/ErrorRecoveryService';\\n\\nconst bus = new EventEmitter();\\nnew ErrorRecoveryService(bus);\\n\\nbus.on('restart', module => {\\n  console.info(`Starte Modul ${module} neu...`);\\n});\\n\\n// In anderen Modulen: bus.emit('error', new Error('...'), 'ModuleName');\\n```\\n\\n#### 10.3 UI-Komponente: ErrorMarker\\n```tsx\\n// src/ui/ErrorMarker.tsx\\nimport React, { useEffect, useState } from 'react';\\n\\nexport function ErrorMarker({ bus }: { bus: any }) {\\n  const [errors, setErrors] = useState<{ module: string; message: string }[]>([]);\\n\\n  useEffect(() => {\\n    function onError(e: { module: string; message: string }) {\\n      setErrors(prev => [...prev, e]);\\n      setTimeout(() => setErrors(prev => prev.slice(1)), 3000);\\n    }\\n    bus.on('ui:error', onError);\\n    return () => bus.off('ui:error', onError);\\n  }, [bus]);\\n\\n  return (\\n    <div className=\\\"error-markers\\\">\\n      {errors.map((e,i) => (\\n        <div key={i} className=\\\"error-marker\\\">\\n          ⚠️ Fehler in {e.module}: {e.message}\\n        </div>\\n      ))}\\n    </div>\\n  );\\n}\\n```\\n\\n#### 10.4 Tests für ErrorRecoveryService\\n```typescript\\n// src/error/ErrorRecoveryService.test.ts\\nimport { EventEmitter } from 'events';\\nimport { ErrorRecoveryService } from './ErrorRecoveryService';\\n\\ndescribe('ErrorRecoveryService', () => {\\n  let bus: EventEmitter;\\n  let recovery: ErrorRecoveryService;\\n\\n  beforeEach(() => {\\n    bus = new EventEmitter();\\n    recovery = new ErrorRecoveryService(bus);\\n  });\\n\\n  it('emits restart and calls fallback tone on error', done => {\\n    jest.spyOn(recovery['fallback'], 'playFallbackTone');\\n    bus.on('restart', module => {\\n      expect(recovery['fallback'].playFallbackTone).toHaveBeenCalled();\\n      expect(module).toBe('TestModule');\\n      done();\\n    });\\n    bus.emit('error', new Error('Test'), 'TestModule');\\n  });\\n});\\n```\\n\\n> **Dokumentation:** Fehler-Events werden zentral behandelt, mit Ton und UI-Marker sichtbar gemacht und Module automatisch neu gestartet.\\n\\n## 11. Performance-Optimierung\"}]}"
