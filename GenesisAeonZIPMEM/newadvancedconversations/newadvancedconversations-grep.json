              "{\"name\":\"config_scaffold\",\"type\":\"code/typescript\",\"content\":\"// src/config/PyramidConfig.ts\\n\\nimport fs from 'fs';\\nimport path from 'path';\\nimport YAML from 'js-yaml';\\nimport Ajv, { JSONSchemaType } from 'ajv';\\n\\n/**\\n * Interface für PyramidConfig (siehe Doku) \\n */\\nexport interface PyramidConfig {\\n  totalLayers: number;\\n  nodesPerLayer: number;\\n  weightFactors: {\\n    coherence: number;\\n    resonance: number;\\n    emergence: number;\\n    poetics: number;\\n  };\\n}\\n\\n// JSON-Schema für Validierung\\nconst schema: JSONSchemaType<PyramidConfig> = {\\n  type: 'object',\\n  properties: {\\n    totalLayers: { type: 'integer', minimum: 1 },\\n    nodesPerLayer: { type: 'integer', minimum: 1 },\\n    weightFactors: {\\n      type: 'object',\\n      properties: {\\n        coherence: { type: 'number', minimum: 0 },\\n        resonance: { type: 'number', minimum: 0 },\\n        emergence: { type: 'number', minimum: 0 },\\n        poetics: { type: 'number', minimum: 0 }\\n      },\\n      required: ['coherence', 'resonance', 'emergence', 'poetics'],\\n      additionalProperties: false\\n    }\\n  },\\n  required: ['totalLayers', 'nodesPerLayer', 'weightFactors'],\\n  additionalProperties: false\\n};\\n\\nconst ajv = new Ajv();\\nconst validate = ajv.compile(schema);\\n\\n/**\\n * Lädt und validiert eine Konfigurationsdatei (JSON oder YAML)\\n * @param fileName Pfad zur Config-Datei\\n */\\nexport function loadConfig(fileName: string): PyramidConfig {\\n  const ext = path.extname(fileName);\\n  const raw = fs.readFileSync(fileName, 'utf-8');\\n  let data: any;\\n\\n  if (ext === '.yaml' || ext === '.yml') {\\n    data = YAML.load(raw);\\n  } else if (ext === '.json') {\\n    data = JSON.parse(raw);\\n  } else {\\n    throw new Error(`Unsupported config format: ${ext}`);\\n  }\\n\\n  if (!validate(data)) {\\n    throw new Error('Invalid PyramidConfig: ' + ajv.errorsText(validate.errors));\\n  }\\n  return data;\\n}\\n\\n// Beispiel Nutzung:\\n// const config = loadConfig('config/pyramidConfig.yaml');\\n// console.log(config);\\n\"}"
            ]
