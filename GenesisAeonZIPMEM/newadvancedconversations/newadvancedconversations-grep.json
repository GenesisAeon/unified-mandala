          "create_time": 1751709447.905902,
              "{\"name\": \"TheoryAgentConfig\", \"type\": \"code/typescript\", \"content\": \"import fs from 'fs';\\nimport path from 'path';\\nimport Ajv, { JSONSchemaType } from 'ajv';\\n\\n/**\\n * Config-Interface für CosmicTheoryAgent\\n */\\nexport interface TheoryAgentConfig {\\n  version: string;\\n  depth: number;\\n  topN: number;\\n  cacheSize: number;\\n  breakerErrorThreshold: number;\\n  resetTimeout: number;\\n  rollingWindowMs: number;\\n  rollingBuckets: number;\\n  regression: {\\n    maxDepth: number;\\n    timeout: number;\\n  };\\n  fractalOptions: {\\n    depth: number;\\n    method: 'wavelet' | 'boxCount' | 'fourier';\\n  };\\n  pythonFallback: {\\n    url: string;\\n    timeout: number;\\n  };\\n  sigilAlert: {\\n    dataMissing: string;\\n    success: string;\\n    minPoetics: number;\\n  };\\n}\\n\\n// JSON-Schema zur Validierung\\nconst theoryConfigSchema: JSONSchemaType<TheoryAgentConfig> = {\\n  type: 'object',\\n  properties: {\\n    version: { type: 'string' },\\n    depth: { type: 'integer', minimum: 1 },\\n    topN: { type: 'integer', minimum: 1 },\\n    cacheSize: { type: 'integer', minimum: 1 },\\n    breakerErrorThreshold: { type: 'number', minimum: 1, maximum: 100 },\\n    resetTimeout: { type: 'integer', minimum: 1000 },\\n    rollingWindowMs: { type: 'integer', minimum: 1 },\\n    rollingBuckets: { type: 'integer', minimum: 1 },\\n    regression: {\\n      type: 'object',\\n      properties: {\\n        maxDepth: { type: 'integer', minimum: 1 },\\n        timeout: { type: 'integer', minimum: 1000 }\\n      },\\n      required: ['maxDepth', 'timeout'],\\n      additionalProperties: false\\n    },\\n    fractalOptions: {\\n      type: 'object',\\n      properties: {\\n        depth: { type: 'integer', minimum: 1 },\\n        method: { type: 'string', enum: ['wavelet', 'boxCount', 'fourier'] }\\n      },\\n      required: ['depth', 'method'],\\n      additionalProperties: false\\n    },\\n    pythonFallback: {\\n      type: 'object',\\n      properties: {\\n        url: { type: 'string', format: 'uri' },\\n        timeout: { type: 'integer', minimum: 1000 }\\n      },\\n      required: ['url', 'timeout'],\\n      additionalProperties: false\\n    },\\n    sigilAlert: {\\n      type: 'object',\\n      properties: {\\n        dataMissing: { type: 'string' },\\n        success: { type: 'string' },\\n        minPoetics: { type: 'number', minimum: 0, maximum: 1 }\\n      },\\n      required: ['dataMissing', 'success', 'minPoetics'],\\n      additionalProperties: false\\n    }\\n  },\\n  required: ['version','depth','topN','cacheSize','breakerErrorThreshold','resetTimeout','rollingWindowMs','rollingBuckets','regression','fractalOptions','pythonFallback','sigilAlert'],\\n  additionalProperties: false\\n};\\n\\nconst ajv = new Ajv({ allErrors: true, useDefaults: true });\\nconst validate = ajv.compile(theoryConfigSchema);\\n\\n/**\\n * Lädt und validiert die Agenten-Konfiguration (YAML oder JSON)\\n * @param filePath Pfad zur Config-Datei\\n */\\nexport function loadConfig(filePath: string): TheoryAgentConfig {\\n  const ext = path.extname(filePath).toLowerCase();\\n  const raw = fs.readFileSync(filePath, 'utf-8');\\n  let data: any;\\n\\n  if (ext === '.json') {\\n    data = JSON.parse(raw);\\n  } else if (ext === '.yaml' || ext === '.yml') {\\n    // yaml library import falls benötigt\\n    const YAML = require('yaml');\\n    data = YAML.parse(raw);\\n  } else {\\n    throw new Error(`Unsupported config format: ${ext}`);\\n  }\\n\\n  if (!validate(data)) {\\n    throw new Error('Invalid TheoryAgentConfig:\\\\n' + ajv.errorsText(validate.errors));\\n  }\\n\\n  return data;\\n}\\n\"}"
