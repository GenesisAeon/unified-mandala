            "text": "{\"name\":\"MandalaCycle_CosmicIntegration.ts\",\"type\":\"code/typescript\",\"content\":\"// src/core/MandalaCycle.ts\\n\\nimport { EventEmitter } from 'events';\\nimport { loadConfig, PyramidConfig } from '../config/PyramidConfig';\\nimport { Sigil, loadSigil } from '../sigils/SigilLoader';\\nimport { combinedWeight, PHI } from '../layers/weights';\\nimport { Layer } from '../layers/Layer';\\nimport { generateNestedLayers } from '../layers/NestedLayersGenerator';\\nimport { AeonCompassionAgent } from '../agents/AeonCompassionAgent';\\n\\n/**\\n * MandalaCycle orchestrates the cyclical refresh of the Mandala,\\n * integrating the cosmic origin Sigil and user empathy.\\n */\\nexport class MandalaCycle {\\n  private bus: EventEmitter;\\n  private config: PyramidConfig;\\n  private rootLayer: Layer;\\n  private cosmicSigil: Sigil;\\n  private compassionAgent: AeonCompassionAgent;\\n\\n  constructor(configPath: string, sigilPath: string, private depth: number = 4, private subdivisions: number = 6) {\\n    this.bus = new EventEmitter();\\n    this.config = loadConfig(configPath);\\n    this.cosmicSigil = loadSigil(sigilPath);\\n    this.rootLayer = generateNestedLayers(this.depth, this.subdivisions);\\n    this.compassionAgent = new AeonCompassionAgent(this.bus);\\n    this.setupCycleHooks();\\n  }\\n\\n  private setupCycleHooks() {\\n    // On cycle start, load cosmic memory and re-weight layers\\n    this.bus.on('cycle:start', () => {\\n      const cosmicFactor = this.cosmicSigil.weightFactors?.coherence || PHI;\\n      this.reweightLayers(this.rootLayer, cosmicFactor);\\n      this.bus.emit('sigil:alert', { id: this.cosmicSigil.sigilId, effect: 'pulse-cosmic' });\\n    });\\n\\n    // Compassion feedback loop\\n    this.bus.on('user:empathy', input => {\\n      this.compassionAgent.process(input, this.rootLayer);\\n    });\\n\\n    // After cycle end, analyze emergent metrics\\n    this.bus.on('cycle:end', () => {\\n      const metrics = this.rootLayer.analyze();\\n      console.info('Emergence Metrics:', metrics);\\n      this.bus.emit('crep:metrics', metrics);\\n    });\\n  }\\n\\n  private reweightLayers(layer: Layer, cosmicFactor: number) {\\n    layer.weight = combinedWeight(layer.level, cosmicFactor);\\n    layer.children?.forEach(child => this.reweightLayers(child, cosmicFactor));\\n  }\\n\\n  /**\\n   * Starts the Mandala cycle: emits start, end events.\\n   */\\n  public start() {\\n    this.bus.emit('cycle:start');\\n    // render & animation would be triggered by UI-bound listeners\\n    this.bus.emit('cycle:end');\\n  }\\n}\\n\\n\\n// src/sigils/SigilLoader.ts\\n\\nimport fs from 'fs';\\nimport path from 'path';\\nimport yaml from 'js-yaml';\\n\\nexport interface Sigil {\\n  sigilId: string;\\n  anchorType: string;\\n  weightFactors?: { coherence: number; resonance: number; emergence: number; poetics: number };\\n}\\n\\n/**\\n * Loads a Sigil from a YAML file.\\n */\\nexport function loadSigil(filePath: string): Sigil {\\n  const raw = fs.readFileSync(path.resolve(filePath), 'utf-8');\\n  return yaml.load(raw) as Sigil;\\n}\\n\\n\\n// src/agents/AeonCompassionAgent.ts\\n\\nimport { EventEmitter } from 'events';\\nimport { Layer } from '../layers/Layer';\\n\\n/**\\n * Processes user empathy inputs and modulates layer weights accordingly.\\n */\\nexport class AeonCompassionAgent {\\n  constructor(private bus: EventEmitter) {}\\n\\n  public process(input: { type: string; intensity: number }, root: Layer) {\\n    // Map empathy to weight adjustments\\n    const factor = Math.min(Math.max(input.intensity, 0), 1);\\n    this.modulateLayers(root, factor);\\n  }\\n\\n  private modulateLayers(layer: Layer, factor: number) {\\n    // e.g., increase poetics weight\\n    layer.weight *= 1 + factor * 0.1;\\n    layer.children?.forEach(child => this.modulateLayers(child, factor));\\n  }\\n}\\n\"}"
