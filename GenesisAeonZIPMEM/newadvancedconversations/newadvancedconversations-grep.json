            "text": "{\"updates\":[{\"pattern\":\".*\",\"multiple\":false,\"replacement\":\"// src/agents/CosmicTheoryAgent.ts\\n\\nimport { CREPManager } from 'crep-engine';\\nimport TypedEmitter from 'typed-emitter';\\nimport { v4 as uuidv4 } from 'uuid';\\nimport pino from 'pino';\\nimport CircuitBreaker from 'opossum';\\nimport { loadCMBMap, loadNeutrinoFlux, CMBData, NeutrinoData } from '../data/CosmicDataLoader';\\nimport { fractalDecompose, FractalOptions } from '../analysis/FractalAnalyzer';\\nimport { symbolicRegressor, FormulaCandidate, RegressionOptions } from '../analysis/SymbolicRegression';\\nimport { registerHistogram, registerCounter } from '../observability/metrics';\\nimport { loadConfig, TheoryAgentConfig } from '../config/TheoryAgentConfig';\\n\\n/**\\n * Definition der Events für den CosmicTheoryAgent\\n */\\ninterface TheoryEvents {\\n  'theory:start': (ctx: { requestId: string }) => void;\\n  'theory:dataLoaded': (ctx: { requestId: string; cmbSize: number; nuSize: number }) => void;\\n  'theory:fractals:generated': (ctx: { requestId: string; depth: number }) => void;\\n  'theory:regression:success': (ctx: { requestId: string; duration: number }) => void;\\n  'sigil_alert': (payload: { id: string; data?: any }) => void;\\n}\\n\\ntype TheoryBus = TypedEmitter<TheoryEvents>;\\n\\nexport class CosmicTheoryAgent {\\n  private crep: CREPManager;\\n  private bus: TheoryBus;\\n  private config: TheoryAgentConfig;\\n  private logger = pino({ name: 'CosmicTheoryAgent' });\\n  private breaker: CircuitBreaker;\\n  private agentVersion = '1.0.0';\\n\\n  constructor(crep: CREPManager, bus: TheoryBus, configPath: string) {\\n    this.crep = crep;\\n    this.bus = bus;\\n    this.config = loadConfig(configPath);\\n\\n    // Circuit Breaker für symbolische Regression\\n    this.breaker = new CircuitBreaker(\\n      (inputs: number[][], outputs: number[]) => symbolicRegressor(inputs, outputs, this.config.regression),\\n      { timeout: this.config.regression.timeout, errorThresholdPercentage: this.config.breakerErrorThreshold, resetTimeout: this.config.resetTimeout }\\n    );\\n  }\\n\\n  /**\\n   * Generiert Top-N Theoriekandidaten als Formeln mit Fehler und Poetik.\\n   */\\n  async generateTheories(): Promise<FormulaCandidate[]> {\\n    const requestId = uuidv4();\\n    this.bus.emit('theory:start', { requestId });\\n\\n    const genHistogram = registerHistogram({\\n      name: 'theory_generation_duration',\\n      labels: { agent: 'cosmic', version: this.agentVersion, dataSource: 'cmb', depth: String(this.config.depth) }\\n    });\\n    const timer = genHistogram.startTimer();\\n    registerCounter({ name: 'theory_generation_requests', labels: { agent: 'cosmic' } }).inc();\\n\\n    // 1. Daten laden\\n    let cmb: CMBData, neutrinos: NeutrinoData;\\n    try {\\n      [cmb, neutrinos] = await Promise.all([loadCMBMap(), loadNeutrinoFlux()]);\\n      this.bus.emit('theory:dataLoaded', { requestId, cmbSize: cmb.anisotropy.length, nuSize: neutrinos.flux.length });\\n    } catch (err) {\\n      this.logger.error({ err, requestId }, 'Datenladung fehlgeschlagen');\\n      this.bus.emit('sigil_alert', { id: this.config.sigilAlert.dataMissing });\\n      timer();\\n      return [];\\n    }\\n\\n    // 2. Validität prüfen\\n    if (!cmb.anisotropy.length || !neutrinos.flux.length) {\\n      this.logger.warn({ requestId }, 'Leere Daten, überspringe Analyse');\\n      this.bus.emit('sigil_alert', { id: this.config.sigilAlert.dataMissing });\\n      timer();\\n      return [];\\n    }\\n\\n    // 3. Fraktale Zerlegung\\n    const fractalOpts: FractalOptions = this.config.fractalOptions;\\n    const cmbLayers = fractalDecompose(cmb.anisotropy, fractalOpts);\\n    const nuLayers = fractalDecompose(neutrinos.flux, fractalOpts);\\n    this.bus.emit('theory:fractals:generated', { requestId, depth: this.config.depth });\\n\\n    const cmbMetrics = cmbLayers.map(layer => layer.analyze());\\n\\n    // 4. Symbolische Regression via CircuitBreaker\\n    let candidates: FormulaCandidate[] = [];\\n    try {\\n      const start = Date.now();\\n      candidates = await this.breaker.fire(\\n        cmbMetrics.map((m, i) => [i, m.emergence]),\\n        cmbMetrics.map(m => m.coherence)\\n      );\\n      const duration = Date.now() - start;\\n      this.bus.emit('theory:regression:success', { requestId, duration });\\n    } catch (err) {\\n      this.logger.error({ err, requestId }, 'Regression fehlgeschlagen');\\n      timer();\\n      return [];\\n    }\\n\\n    // 5. Scoring & Filter\\n    const scored = candidates.map(c => ({ ...c, poetics: this.crep.evaluatePoetics(c.formula) }));\\n\\n    // 6. Alert on best candidate\\n    const best = scored\\n      .sort((a, b) => a.error - b.error)[0];\\n    if (best && best.poetics >= this.config.sigilAlert.minPoetics) {\\n      this.bus.emit('sigil_alert', { id: this.config.sigilAlert.success, data: best });\\n    }\\n\\n    timer();\\n    return scored\\n      .sort((a, b) => (a.error - b.error) - (a.poetics - b.poetics))\\n      .slice(0, this.config.topN);\\n  }\\n}\\n\\n// src/config/TheoryAgentConfig.ts\\nimport fs from 'fs';\\nimport YAML from 'js-yaml';\\nimport Ajv, { JSONSchemaType } from 'ajv';\\n\\nexport interface RegressionOptions { maxDepth: number; timeout: number; }\\nexport interface SigilAlertConfig { dataMissing: string; success: string; minPoetics: number; }\\nexport interface TheoryAgentConfig {\\n  depth: number;\\n  topN: number;\\n  timeout: number;\\n  resetTimeout: number;\\n  breakerErrorThreshold: number;\\n  regression: RegressionOptions;\\n  fractalOptions: { depth: number; method: string; };\\n  sigilAlert: SigilAlertConfig;\\n}\\n\\nconst schema: JSONSchemaType<TheoryAgentConfig> = {\\n  type: 'object',\\n  properties: {\\n    depth: { type: 'integer', minimum: 1 },\\n    topN: { type: 'integer', minimum: 1 },\\n    timeout: { type: 'integer', minimum: 100 },\\n    resetTimeout: { type: 'integer', minimum: 1000 },\\n    breakerErrorThreshold: { type: 'number', minimum: 1, maximum: 100 },\\n    regression: {\\n      type: 'object',\\n      properties: {\\n        maxDepth: { type: 'integer', minimum: 1 },\\n        timeout: { type: 'integer', minimum: 100 }\\n      },\\n      required: ['maxDepth', 'timeout'],\\n      additionalProperties: false\\n    },\\n    fractalOptions: {\\n      type: 'object',\\n      properties: {\\n        depth: { type: 'integer', minimum: 1 },\\n        method: { type: 'string' }\\n      },\\n      required: ['depth', 'method'],\\n      additionalProperties: false\\n    },\\n    sigilAlert: {\\n      type: 'object',\\n      properties: {\\n        dataMissing: { type: 'string' },\\n        success: { type: 'string' },\\n        minPoetics: { type: 'number', minimum: 0 }\\n      },\\n      required: ['dataMissing', 'success', 'minPoetics'],\\n      additionalProperties: false\\n    }\\n  },\\n  required: ['depth','topN','timeout','resetTimeout','breakerErrorThreshold','regression','fractalOptions','sigilAlert'],\\n  additionalProperties: false\\n};\\n\\nconst ajv = new Ajv();\\nconst validate = ajv.compile(schema);\\n\\nexport function loadConfig(path: string): TheoryAgentConfig {\\n  const raw = fs.readFileSync(path, 'utf-8');\\n  const data = YAML.load(raw) as any;\\n  if (!validate(data)) throw new Error('Ungültige TheoryAgentConfig: ' + ajv.errorsText(validate.errors));\\n  return data;\\n}\\n\\n// Beispiel: config/cosmic-theory-agent.yaml\\n/*\\ndepth: 5\\ntopN: 5\\ntimeout: 5000\\nresetTimeout: 30000\\nbreakerErrorThreshold: 50\\nregression:\\n  maxDepth: 4\\n  timeout: 2000\\nfractalOptions:\\n  depth: 5\\n  method: 'wavelet'\\nsigilAlert:\\n  dataMissing: 'aeon:warning-data-missing'\\n  success: 'aeon:2025-0705-COSMIC-THEORY'\\n  minPoetics: 0.8\\n*/\"}]}"
