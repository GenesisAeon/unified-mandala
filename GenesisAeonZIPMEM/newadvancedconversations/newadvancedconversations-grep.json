              "{\"updates\":[{\"pattern\":\".*\",\"multiple\":false,\"replacement\":\"```typescript\\n// src/agents/CosmicTheoryAgent.ts\\n\\nimport { CREPManager } from 'crep-engine';\\nimport TypedEmitter from 'typed-emitter';\\nimport { v4 as uuidv4 } from 'uuid';\\nimport pino from 'pino';\\nimport CircuitBreaker from 'opossum';\\nimport LRUCache from 'lru-cache';\\nimport axios from 'axios';\\nimport { context, trace, Span, Tracer } from '@opentelemetry/api';\\nimport { loadCMBMap, loadNeutrinoFlux, CMBData, NeutrinoData } from '../data/CosmicDataLoader';\\nimport { fractalDecompose, FractalOptions } from '../analysis/FractalAnalyzer';\\nimport { boxCountDecompose } from '../analysis/BoxCountDecompose';\\nimport { fourierDecompose } from '../analysis/FourierDecompose';\\nimport { symbolicRegressor, FormulaCandidate, RegressionOptions } from '../analysis/SymbolicRegression';\\nimport { registerHistogram, registerCounter } from '../observability/metrics';\\nimport { loadConfig, TheoryAgentConfig } from '../config/TheoryAgentConfig';\\n\\n/**\\n * Events für den CosmicTheoryAgent mit Trace-Context\\n */\\ninterface TheoryEvents {\\n  'theory:start': (ctx: TheoryContext) => void;\\n  'theory:dataLoaded': (ctx: TheoryContext & { cmbSize: number; nuSize: number }) => void;\\n  'theory:fractals:generated': (ctx: TheoryContext & { depth: number }) => void;\\n  'theory:regression:success': (ctx: TheoryContext & { duration: number }) => void;\\n  'sigil_alert': (ctx: TheoryContext & { id: string; data?: any }) => void;\\n  'user:theory_feedback': (ctx: TheoryContext & { formula: string; rating: number }) => void;\\n}\\n\\ntype TheoryBus = TypedEmitter<TheoryEvents>;\\n\\n/**\\n * Kontext für verteiltes Tracing und Logs\\n */\\ninterface TheoryContext {\\n  requestId: string;\\n  timestamp: number;\\n  agentVersion: string;\\n  configVersion: string;\\n  userSessionId?: string;\\n  span?: Span;\\n}\\n\\nexport class CosmicTheoryAgent {\\n  private crep: CREPManager;\\n  private bus: TheoryBus;\\n  private config: TheoryAgentConfig;\\n  private logger;\\n  private breaker: CircuitBreaker;\\n  private tracer: Tracer;\\n  private cache: LRUCache<string, FormulaCandidate[]>;\\n  private agentVersion = '1.1.0';\\n\\n  constructor(crep: CREPManager, bus: TheoryBus, configPath: string) {\\n    this.crep = crep;\\n    this.bus = bus;\\n\\n    // 1) Config laden und validieren\\n    this.config = loadConfig(configPath);\\n\\n    // 2) Logger mit Basis-Metadaten\\n    this.logger = pino({\\n      name: 'CosmicTheoryAgent',\\n      base: { agentVersion: this.agentVersion, configVersion: this.config.version }\\n    });\\n\\n    // 3) Cache initialisieren\\n    this.cache = new LRUCache({ max: this.config.cacheSize });\\n\\n    // 4) Tracer instanziieren\\n    this.tracer = trace.getTracer('CosmicTheoryAgent', this.agentVersion);\\n\\n    // 5) Circuit Breaker mit konfigurierten Parametern\\n    this.breaker = new CircuitBreaker(\\n      (inputs: number[][], outputs: number[]) => symbolicRegressor(inputs, outputs, this.config.regression),\\n      {\\n        timeout: this.config.regression.timeout,\\n        errorThresholdPercentage: this.config.breakerErrorThreshold,\\n        resetTimeout: this.config.resetTimeout,\\n        rollingCountTimeout: this.config.rollingWindowMs,\\n        rollingCountBuckets: this.config.rollingBuckets\\n      }\\n    );\\n\\n    // Circuit-Breaker-Events loggen\\n    this.breaker.on('open', () => this.logger.warn('Breaker geöffnet'));\\n    this.breaker.on('halfOpen', () => this.logger.info('Breaker halb-offen'));\\n    this.breaker.on('close', () => this.logger.info('Breaker geschlossen'));\\n    this.breaker.on('snapshot', stats => this.logger.debug({ stats }, 'Breaker snapshot'));\\n  }\\n\\n  /**\\n   * Generiert Top-N Theoriekandidaten, nutzt Caching und Python-Fallback\\n   */\\n  async generateTheories(userContext?: { userSessionId?: string }): Promise<FormulaCandidate[]> {\\n    const requestId = uuidv4();\\n    const ctx: TheoryContext = {\\n      requestId,\\n      timestamp: Date.now(),\\n      agentVersion: this.agentVersion,\\n      configVersion: this.config.version,\\n      userSessionId: userContext?.userSessionId\\n    };\\n    const span = this.tracer.startSpan('generateTheories');\\n    ctx.span = span;\\n\\n    this.bus.emit('theory:start', ctx);\\n\\n    // Caching\\n    const cacheKey = `${this.config.depth}-${this.config.regression.maxDepth}`;\\n    if (this.cache.has(cacheKey)) {\\n      const cached = this.cache.get(cacheKey)!;\\n      // Hintergrund-Refresh\\n      this.refreshCache(cacheKey, ctx, span).catch(err => this.logger.error(err));\\n      span.end();\\n      return cached;\\n    }\\n\\n    // Observability: Metriken\\n    const hist = registerHistogram({\\n      name: 'theory_generation_duration',\\n      labels: { agent: 'cosmic', version: this.agentVersion, method: this.config.fractalOptions.method }\\n    });\\n    const timer = hist.startTimer();\\n    registerCounter({ name: 'theory_generation_requests', labels: { agent: 'cosmic', method: this.config.fractalOptions.method } }).inc();\\n\\n    // 1) Daten Asynchron laden\\n    let cmb: CMBData, neutrinos: NeutrinoData;\\n    try {\\n      [cmb, neutrinos] = await Promise.all([loadCMBMap(), loadNeutrinoFlux()]);\\n      this.bus.emit('theory:dataLoaded', { ...ctx, cmbSize: cmb.anisotropy.length, nuSize: neutrinos.flux.length });\\n    } catch (err) {\\n      this.logger.error({ err, requestId }, 'Datenladung fehlgeschlagen');\\n      this.bus.emit('sigil_alert', { ...ctx, id: this.config.sigilAlert.dataMissing });\\n      timer(); span.end();\\n      return [];\\n    }\\n\\n    if (!cmb.anisotropy.length || !neutrinos.flux.length) {\\n      this.logger.warn({ requestId }, 'Leere Daten, überspringe Analyse');\\n      this.bus.emit('sigil_alert', { ...ctx, id: this.config.sigilAlert.dataMissing });\\n      timer(); span.end();\\n      return [];\\n    }\\n\\n    // 2) Fraktale Zerlegung\\n    const fractalFn = this.getFractalMethod(this.config.fractalOptions.method);\\n    const cmbLayers = fractalFn(cmb.anisotropy, this.config.fractalOptions);\\n    const nuLayers = fractalFn(neutrinos.flux, this.config.fractalOptions);\\n    this.bus.emit('theory:fractals:generated', { ...ctx, depth: this.config.fractalOptions.depth });\\n\\n    const inputs = cmbLayers.map((m, i) => [i, m.emergence]);\\n    const outputs = cmbLayers.map(m => m.coherence);\\n\\n    // 3) Regression mit Circuit Breaker\\n    let candidates: FormulaCandidate[];\\n    try {\\n      candidates = await this.breaker.fire(inputs, outputs);\\n    } catch (err) {\\n      this.logger.warn({ err, requestId }, 'JS-Regression fehlgeschlagen, Python-Fallback');\\n      candidates = await this.callPythonService(inputs, outputs);\\n    }\\n\\n    this.bus.emit('theory:regression:success', { ...ctx, duration: timer() });\\n\\n    // 4) Scoring & Filter\\n    const scored = candidates.map(c => ({ ...c, poetics: this.crep.evaluatePoetics(c.expression) }));\\n\\n    // 5) Sigil-Alert\\n    const best = scored.sort((a, b) => a.error - b.error)[0];\\n    if (best?.poetics! >= this.config.sigilAlert.minPoetics) {\\n      this.bus.emit('sigil_alert', { ...ctx, id: this.config.sigilAlert.success, data: best });\\n    }\\n\\n    // 6) Cache setzen und Return\\n    this.cache.set(cacheKey, scored.slice(0, this.config.topN));\\n    span.end();\\n    return scored.slice(0, this.config.topN);\\n  }\\n\\n  /** Holt die korrekte Zerlegungsfunktion */\\n  private getFractalMethod(name: string) {\\n    const methods: Record<string, (data: number[], opts: FractalOptions) => any[]> = {\\n      wavelet: fractalDecompose,\\n      boxCount: boxCountDecompose,\\n      fourier: fourierDecompose\\n    };\\n    return methods[name] || fractalDecompose;\\n  }\\n\\n  /** Python-Microservice-Aufruf als Fallback */\\n  private async callPythonService(inputs: number[][], outputs: number[]): Promise<FormulaCandidate[]> {\\n    const { url, timeout } = this.config.pythonFallback;\\n    const resp = await axios.post(url, { inputs, outputs }, { timeout });\\n    return resp.data as FormulaCandidate[];\\n  }\\n\\n  /** Hintergrund-Refresh des Caches ohne Event-Loop-Block */\\n  private async refreshCache(key: string, ctx: TheoryContext, parentSpan?: Span) {\\n    const span = this.tracer.startSpan('refreshCache', { parent: parentSpan });\\n    try {\\n      const fresh = await this.generateTheories({ userSessionId: ctx.userSessionId });\\n      this.cache.set(key, fresh);\\n    } catch (err) {\\n      this.logger.warn({ err, requestId: ctx.requestId }, 'RefreshCache fehlgeschlagen');\\n    } finally {\\n      span.end();\\n    }\\n  }\\n}\\n```\"}]}"
