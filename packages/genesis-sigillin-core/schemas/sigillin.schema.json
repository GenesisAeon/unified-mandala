{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "schema_version": { "type": "string" },
    "id": { "type": "string" },
    "type": { "type": "string", "enum": ["fallback-anchor", "poetic-root", "crep-trigger", "session-memory", "ethik-node"] },
    "status": { "type": "string", "enum": ["draft", "reviewed", "published"] },
    "creator": { "type": "string" },
    "created_at": { "type": "string", "format": "date-time" },
    "related_sigils": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": { "type": "string" },
          "relation": { "type": "string", "enum": ["derivesFrom", "complements", "follows", "precedes"] }
        },
        "required": ["id", "relation"]
      }
    },
    "changes": { "type": "array", "items": { "type": "string" } }
  },
  "required": ["schema_version", "id", "type", "status", "creator", "created_at"]
}
