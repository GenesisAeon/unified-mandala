r) {\\n  prompt := fmt.Sprintf(\\\"# Python snippet for: %s\\\", req.Description)\\n  code, err := a.client.Ask(ctx, prompt)\\n  return GenerateSnippetResponse{Code: code}, err\\n}\\n```\\n\\n### 10.3 Go Agent (`pkg/codeagent/go_agent/client.go`)\\n```go\\npackage go_agent\\n\\nimport (\\n  \\\"context\\\"\\n  \\\"fmt\\\"\\n  \\\"github.com/GenesisAeon/unifiedmandala/pkg/gpt\\\"\\n)\\n\\ntype GoAgent struct { client *gpt.GPTClient }\\n\\nfunc NewGoAgent(endpoint, apiKey string) *GoAgent {\\n  return &GoAgent{client: gpt.NewClient(endpoint, apiKey)}\\n}\\n\\nfunc (a *GoAgent) GenerateTests(ctx context.Context, modulePath string) (string, error) {\\n  prompt := fmt.Sprintf(\\\"Generate unit tests for Go package: %s\\\", modulePath)\\n  return a.client.Ask(ctx, prompt)\\n}\\n```\\n\\n### 10.4 UI-Komponenten: CodeAgentPanel\\n```tsx\\nimport React, { useState } from 'react'\\nimport { Button, Input } from '@/components/ui'\\nimport { invoke } from '@/lib/api'\\n\\nexport function CodeAgentPanel({ language }: { language: string }) {\\n  const [desc, setDesc] = useState('')\\n  const [output, setOutput] = useState('')\\n\\n  const handleRun = async () => {\\n    const res = await invoke(`/codeagent/${language}/generate`, { description: desc })\\n    setOutput(res.code)\\n  }\\n\\n  return (\\n    <div>\\n      <Input\\n        placeholder={`Describe ${language} snippet...`}\\n        value={desc}\\n        onChange={e => setDesc(e.target.value)}\\n      />\\n      <Button onClick={handleRun}>Generate</Button>\\n      <pre>{output}</pre>\\n    </div>\\n  )\\n}\\n```\\n\\n### 10.5 CLI-Integration (`cmd/mandala-codeagent.go`)\\n```go\\npackage main\\n\\nimport (\\n  \\\"context\\\"\\n  \\\"flag\\\"\\n  \\\"fmt\\\"\\n  \\\"github.com/GenesisAeon/unifiedmandala/pkg/codeagent/python_agent\\\"\\n  \\\"github.com/GenesisAeon/unifiedmandala/pkg/codeagent/go_agent\\\"\\n)\\n\\nfunc main() {\\n  lang := flag.String(\\\"lang\\\", \\\"python\\\", \\\"programming language\\\")\\n  desc := flag.String(\\\"desc\\\", \\\"\\\", \\\"description of code snippet\\\")\\n  endpoint := flag.String(\\\"endpoint\\\", \\\"https://api.openai.com/v1/chat/completions\\\", \\\"GPT endpoint\\\")\\n  apiKey := flag.String(\\\"apiKey\\\", \\\"\\\", \\\"GPT API key\\\")\\n  flag.Parse()\\n\\n  ctx := context.Background()\\n  switch *lang {\\n  case \\\"python\\\":\\n    agent := python_agent.NewPythonAgent(*endpoint, *apiKey)\\n    resp, err := agent.GenerateSnippet(ctx, python_agent.GenerateSnippetRequest{Description: *desc})\\n    fmt.Println(resp.Code, err)\\n  case \\\"go\\\":\\n    agent := go_agent.NewGoAgent(*endpoint, *apiKey)\\n    code, err := agent.GenerateTests(ctx, *desc)\\n    fmt.Println(code, err)\\n  default:\\n    fmt.Println(\\\"Unsupported language\\\")\\n  }\\n}\\n```\\n\\n### 10.6 Integration & Sicherheit\\n- **Rate-Limits & Retries** zentral im `common/api.go` implementieren.\\n- **Schema-Validation** für Requests/Responses mit JSON-Schema.\\n- **Sigil-Logging**: Für jede Codegen-Aktion ein Sigil mit `promptHash`, `responseHash` und `language` erzeugen.\\n\\nMit dieser Section hast du einen vollwertigen **Programming Language Agent** in Go und UI, der verschiedenste Sprachmodelle orchestriert und in dein Mandala-Ökosystem integriert. 🚀\"}]}"
