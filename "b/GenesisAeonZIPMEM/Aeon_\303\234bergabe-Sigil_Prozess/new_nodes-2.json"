      "content": {
        "content_type": "text",
        "parts": [
          "{\"updates\":[{\"pattern\":\".*\",\"multiple\":false,\"replacement\":\"#!/usr/bin/env node\\n/**\\n * scripts/fragment_and_package_conversations.js\\n * \\n * Reads conversation.json, fragments into individual chat files,\\n * filters personal data (emails, phones, names, URLs), zips fragments into GenesisAeonZIPMEM/,\\n * and generates a mapping file with processing directives.\\n * Also exports a helper function to deposit new content with rules.\\n */\\n\\nconst fs = require('fs');\\nconst path = require('path');\\nconst archiver = require('archiver');\\n\\n// Configuration\\nconst INPUT_FILE = path.join(__dirname, '../data/conversation.json');\\nconst OUTPUT_DIR = path.join(__dirname, '../GenesisAeonZIPMEM');\\nconst MAPPING_FILE = path.join(OUTPUT_DIR, 'mapping.json');\\n\\n// Utility: personal data filter (regex-based)\\nfunction sanitizeText(text) {\\n  return text\\n    // Remove URLs (http, https, www)\\n    .replace(/https?:\\\\/\\\\/\\\\S+/gi, '[REDACTED_URL]')\\n    .replace(/www\\\\.\\\\S+/gi, '[REDACTED_URL]')\\n    // Remove email addresses\\n    .replace(/\\\\b[\\\\w.+-]+@[\\\\w.-]+\\\\.[a-zA-Z]{2,}\\\\b/g, '[REDACTED_EMAIL]')\\n    // Remove phone numbers (simple pattern)\\n    .replace(/\\\\b\\\\+?[0-9][0-9()\\\\-\\\\s]{7,}\\\\b/g, '[REDACTED_PHONE]')\\n    // Remove personal names (First Last)\\n    .replace(/\\\\b[A-Z][a-z]+ [A-Z][a-z]+\\\\b/g, '[REDACTED_NAME]');\\n}\\n\\n// Main process: fragment chats, sanitize, zip, mapping\\nasync function fragmentAndPackage() {\\n  const data = JSON.parse(fs.readFileSync(INPUT_FILE, 'utf8'));\\n  if (!fs.existsSync(OUTPUT_DIR)) fs.mkdirSync(OUTPUT_DIR, { recursive: true });\\n\\n  const mapping = [];\\n\\n  // Group messages by chatId\\n  const chats = data.messages.reduce((acc, msg) => {\\n    const id = msg.chatId || 'unknown';\\n    acc[id] = acc[id] || [];\\n    acc[id].push(msg);\\n    return acc;\\n  }, {});\\n\\n  // Write each chat fragment\\n  for (const [chatId, msgs] of Object.entries(chats)) {\\n    const filename = `chat_${chatId}.json`;\\n    const filepath = path.join(OUTPUT_DIR, filename);\\n    const sanitized = msgs.map(m => ({ ...m, content: sanitizeText(m.content) }));\\n    fs.writeFileSync(filepath, JSON.stringify(sanitized, null, 2));\\n    mapping.push({ chatId, file: filename, processor: 'fragmentAndSanitize' });\\n  }\\n\\n  // Create zip archive of chat fragments\\n  const zipPath = path.join(OUTPUT_DIR, 'chats_bundle.zip');\\n  const output = fs.createWriteStream(zipPath);\\n  const archive = archiver('zip', { zlib: { level: 9 } });\\n  output.on('close', () => console.log(`ZIP created: ${zipPath} (${archive.pointer()} bytes)`));\\n  archive.pipe(output);\\n  fs.readdirSync(OUTPUT_DIR)\\n    .filter(f => f.startsWith('chat_') && f.endsWith('.json'))\\n    .forEach(f => archive.file(path.join(OUTPUT_DIR, f), { name: f }));\\n  await archive.finalize();\\n\\n  // Write mapping file\\n  fs.writeFileSync(MAPPING_FILE, JSON.stringify(mapping, null, 2));\\n  console.log(`Mapping file written to ${MAPPING_FILE}`);\\n}\\n\\n// Helper to deposit content with rules\\nfunction depositContent(folder, contentObj, rules) {\\n  const targetDir = path.join(OUTPUT_DIR, folder);\\n  if (!fs.existsSync(targetDir)) fs.mkdirSync(targetDir, { recursive: true });\\n  const timestamp = new Date().toISOString().replace(/[:.]/g, '-');\\n  const filename = `content_${timestamp}.json`;\\n  fs.writeFileSync(\\n    path.join(targetDir, filename),\\n    JSON.stringify({ metadata: rules, content: contentObj }, null, 2)\\n  );\\n  console.log(`Deposited content to ${path.join(folder, filename)}`);\\n}\\n\\n// Execute script if run directly\\nif (require.main === module) {\\n  fragmentAndPackage().catch(err => console.error(err));\\n}\\n\\nmodule.exports = { fragmentAndPackage, depositContent };\"}]}"
