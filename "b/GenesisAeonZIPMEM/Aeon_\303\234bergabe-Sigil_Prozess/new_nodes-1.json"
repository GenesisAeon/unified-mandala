          "{\"updates\":[{\"pattern\":\".*\",\"multiple\":false,\"replacement\":\"#!/usr/bin/env node\\n/**\\n * scripts/fragment_and_package_conversations.js\\n * \\n * Reads conversation.json, fragments into individual chat files,\\n * filters personal data (emails, phones, names, URLs) and domain-specific content\\n * based on YAML filter definitions, zips fragments into GenesisAeonZIPMEM/,\\n * and generates a mapping file with processing directives.\\n * Also exports a helper function to deposit new content with rules.\\n */\\n\\nconst fs = require('fs');\\nconst path = require('path');\\nconst archiver = require('archiver');\\nconst yaml = require('js-yaml');\\n\\n// Configuration\\nconst INPUT_FILE = path.join(__dirname, '../data/conversation.json');\\nconst OUTPUT_DIR = path.join(__dirname, '../GenesisAeonZIPMEM');\\nconst MAPPING_FILE = path.join(OUTPUT_DIR, 'mapping.json');\\nconst FILTER_CONFIG_DIR = path.join(__dirname, '../config/filter-config');\\n\\n// Utility: personal data filter (regex-based)\\nfunction sanitizeText(text) {\\n  return text\\n    .replace(/https?:\\\\/\\\\/\\\\S+/gi, '[REDACTED_URL]')\\n    .replace(/www\\\\.\\\\S+/gi, '[REDACTED_URL]')\\n    .replace(/\\\\b[\\\\w.+-]+@[\\\\w.-]+\\\\.[a-zA-Z]{2,}\\\\b/g, '[REDACTED_EMAIL]')\\n    .replace(/\\\\b\\\\+?[0-9][0-9()\\\\-\\\\s]{7,}\\\\b/g, '[REDACTED_PHONE]')\\n    .replace(/\\\\b[A-Z][a-z]+ [A-Z][a-z]+\\\\b/g, '[REDACTED_NAME]');\\n}\\n\\n// Load YAML filter configurations\\nfunction loadFilterConfigs() {\\n  const configs = [];\\n  if (!fs.existsSync(FILTER_CONFIG_DIR)) return configs;\\n  fs.readdirSync(FILTER_CONFIG_DIR).forEach(file => {\\n    if (file.endsWith('.yaml') || file.endsWith('.yml')) {\\n      const cfg = yaml.load(fs.readFileSync(path.join(FILTER_CONFIG_DIR, file), 'utf8'));\\n      configs.push(cfg);\\n    }\\n  });\\n  return configs;\\n}\\n\\n// Apply domain-specific filters to messages\\nfunction applyDomainFilters(messages, configs) {\\n  return messages.filter(msg => {\\n    for (const cfg of configs) {\\n      const domain = cfg.domain;\\n      if (msg.content.includes(domain)) return true;\\n    }\\n    return false;\\n  });\\n}\\n\\nasync function fragmentAndPackage() {\\n  const data = JSON.parse(fs.readFileSync(INPUT_FILE, 'utf8'));\\n  if (!fs.existsSync(OUTPUT_DIR)) fs.mkdirSync(OUTPUT_DIR, { recursive: true });\\n\\n  const filterConfigs = loadFilterConfigs();\\n  const mapping = [];\\n\\n  // Group and process chats\\n  const chats = data.messages.reduce((acc, msg) => {\\n    const id = msg.chatId || 'unknown';\\n    acc[id] = acc[id] || [];\\n    acc[id].push(msg);\\n    return acc;\\n  }, {});\\n\\n  for (const [chatId, msgs] of Object.entries(chats)) {\\n    let processed = msgs.map(m => ({ ...m, content: sanitizeText(m.content) }));\\n    // Domain filtering if configs exist\\n    if (filterConfigs.length) processed = applyDomainFilters(processed, filterConfigs);\\n\\n    const filename = `chat_${chatId}.json`;\\n    const filepath = path.join(OUTPUT_DIR, filename);\\n    fs.writeFileSync(filepath, JSON.stringify(processed, null, 2));\\n    mapping.push({ chatId, file: filename, processor: filterConfigs.length ? 'domainFilter' : 'fragmentAndSanitize' });\\n  }\\n\\n  // Zip chat fragments\\n  const zipPath = path.join(OUTPUT_DIR, 'chats_bundle.zip');\\n  const output = fs.createWriteStream(zipPath);\\n  const archive = archiver('zip', { zlib: { level: 9 } });\\n  output.on('close', () => console.log(`ZIP created: ${zipPath} (${archive.pointer()} bytes)`));\\n  archive.pipe(output);\\n  fs.readdirSync(OUTPUT_DIR)\\n    .filter(f => f.startsWith('chat_') && f.endsWith('.json'))\\n    .forEach(f => archive.file(path.join(OUTPUT_DIR, f), { name: f }));\\n  await archive.finalize();\\n\\n  // Write mapping file\\n  fs.writeFileSync(MAPPING_FILE, JSON.stringify(mapping, null, 2));\\n  console.log(`Mapping file written to ${MAPPING_FILE}`);\\n}\\n\\n// Helper to deposit content with rules\\nfunction depositContent(folder, contentObj, rules) {\\n  const targetDir = path.join(OUTPUT_DIR, folder);\\n  if (!fs.existsSync(targetDir)) fs.mkdirSync(targetDir, { recursive: true });\\n  const timestamp = new Date().toISOString().replace(/[:.]/g, '-');\\n  const filename = `content_${timestamp}.json`;\\n  fs.writeFileSync(\\n    path.join(targetDir, filename),\\n    JSON.stringify({ metadata: rules, content: contentObj }, null, 2)\\n  );\\n  console.log(`Deposited content to ${path.join(folder, filename)}`);\\n}\\n\\nif (require.main === module) {\\n  fragmentAndPackage().catch(err => console.error(err));\\n}\\n\\nmodule.exports = { fragmentAndPackage, depositContent };\\n\"}]}"
