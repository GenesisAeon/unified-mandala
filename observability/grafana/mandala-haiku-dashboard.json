{
  "title": "MandalaHaiku Metrics",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "panels": [
    {
      "type": "graph",
      "title": "Haikus Generated",
      "datasource": "Prometheus",
      "targets": [
        {
          "expr": "mandala_haiku_generated_total",
          "legendFormat": "haikus"
        }
      ]
    },
    {
      "id": 9101,
      "type": "stat",
      "title": "Boundary  Laws/min",
      "datasource": null,
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 0 },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(boundary_laws_accepted_total[5m])) * 60",
          "instant": true,
          "legendFormat": "laws/min",
          "datasource": null
        }
      ],
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "orientation": "auto",
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "center",
        "textMode": "value_and_name"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "decimals": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "orange", "value": 10 },
              { "color": "red", "value": 30 }
            ]
          }
        },
        "overrides": []
      },
      "transparent": true
    },
    {
      "id": 9102,
      "type": "timeseries",
      "title": "Boundary  p95 observe latency (ms, 1h)",
      "datasource": null,
      "gridPos": { "h": 6, "w": 18, "x": 6, "y": 0 },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum(rate(boundary_observe_latency_ms_bucket[5m])) by (le))",
          "legendFormat": "p95 (ms)",
          "datasource": null
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "ms", "decimals": 0 },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom" },
        "tooltip": { "mode": "single" }
      },
      "transparent": true
    }
  ]
}
