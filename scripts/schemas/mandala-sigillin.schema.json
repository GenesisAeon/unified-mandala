{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Mandala Sigillin Core Validation Schema",
  "type": "object",
  "properties": {
    "sigillin": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "id": { "type": "string", "minLength": 3 },
        "title": { "type": "string", "minLength": 3 },
        "created_by": { "type": "string" },
        "timestamp": { "type": "string" },
        "sigillin_type": { "type": "string", "minLength": 3 },
        "audience": { "type": "string" },
        "essenz": { "type": "string", "minLength": 3 },
        "trigger_phrase": { "type": "string" },
        "tags": { "type": "array", "items": { "type": "string" } },
        "links": { "type": "array", "items": { "type": "string" } },
        "trace": {
          "type": "object",
          "additionalProperties": true,
          "properties": {
            "CREP": {
              "type": "object",
              "minProperties": 2,
              "additionalProperties": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              }
            },
            "emergence_score": {
              "type": "number",
              "minimum": 0
            }
          },
          "required": ["CREP"]
        },
        "content": {
          "type": "object",
          "additionalProperties": true,
          "properties": {
            "type": { "type": "string" },
            "text": { "type": "string" },
            "sections": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "additionalProperties": true,
                "properties": {
                  "id": { "type": "string", "minLength": 1 },
                  "title": { "type": "string", "minLength": 1 },
                  "rules": {
                    "type": "array",
                    "items": { "type": "string" }
                  }
                },
                "required": ["id", "title"]
              }
            }
          },
          "required": ["sections"]
        }
      },
      "required": ["id", "title", "sigillin_type", "audience", "essenz", "content"]
    }
  },
  "required": ["sigillin"]
}
