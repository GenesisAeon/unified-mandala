{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "outDir": "dist",
    "rootDir": "src",
    "strict": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "types": ["node"],
    "baseUrl": "../../",
    "paths": {
      "@unified-mandala/ai": ["packages/ai/src/index.ts"],
      "@config/*": ["config/*"]
    }
  },
  "include": ["src/**/*"]
}
