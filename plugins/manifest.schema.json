{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "plugins": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "version", "component"],
        "properties": {
          "name": { "type": "string" },
          "version": { "type": "string" },
          "component": { "type": "string" },
          "dataHook": { "type": "string" },
          "crepCondition": { "type": "string" },
          "story": { "type": "string" },
          "layoutSuggestion": { "type": "string" }
        },
        "additionalProperties": false
      }
    }
  },
  "required": ["plugins"],
  "additionalProperties": false
}
