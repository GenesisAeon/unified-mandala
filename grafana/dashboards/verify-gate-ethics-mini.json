        {
          "expr": "rate(verify_gate_idem_hits_total[5m])",
          "legendFormat": "duplicates/min",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops/min",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
