{
  "$id": "https://unifiedmandala.dev/schema/stac-item.schema.json",
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "STAC Item (strict++)",
  "type": "object",
  "required": ["type", "stac_version", "id", "bbox", "geometry", "properties", "assets"],
  "additionalProperties": false,
  "properties": {
    "type": { "const": "Feature" },
    "stac_version": { "type": "string", "pattern": "^1\\.[0-9]+\\.[0-9]+" },
    "id": { "type": "string", "minLength": 1 },
    "bbox": { "type": "array", "minItems": 4, "items": { "type": "number" } },
    "geometry": {
      "type": "object",
      "required": ["type", "coordinates"],
      "additionalProperties": false,
      "properties": {
        "type": { "enum": ["Polygon", "MultiPolygon"] },
        "coordinates": { "type": "array" }
      }
    },
    "properties": {
      "type": "object",
      "required": ["datetime"],
      "additionalProperties": true,
      "properties": { "datetime": { "type": "string", "format": "date-time" } }
    },
    "assets": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "required": ["href", "type", "roles"],
        "additionalProperties": true,
        "properties": {
          "href": { "type": "string", "format": "uri-reference" },
          "type": { "type": "string", "pattern": "^(application|image|text)/" },
          "roles": { "type": "array", "minItems": 1, "items": { "type": "string" } }
        }
      }
    }
  }
}
